  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Verificación rápida en MySQL"
   ],
   "id": "7cc538e2bedaa98a"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-24T08:38:39.341538200Z",
     "start_time": "2026-11-24T08:38:33.562551300Z"
    }
   },
   "source": [
    "import mysql.connector\n",
    "import pandas as pd\n",
    "\n",
    "conn = mysql.connector.connect(**DB_CONFIG)\n",
    "resumen_sql = \"\"\"\n",
    "SELECT \n",
    "    country_code AS pais,\n",
    "    taxon_rank AS rango,\n",
    "    specific_epithet AS epiteto,\n",
    "    COUNT(*) AS total_registros,\n",
    "    MIN(year) AS anio_min,\n",
    "    MAX(year) AS anio_max\n",
    "FROM ocurrencias\n",
    "GROUP BY country_code, taxon_rank, specific_epithet\n",
    "ORDER BY pais, total_registros DESC;\n",
    "\"\"\"\n",
    "df_verificacion = pd.read_sql(resumen_sql, conn)\n",
    "conn.close()\n",
    "\n",
    "df_verificacion"
   ],
